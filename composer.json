{
    "name": "vandaschool/bordar",
    "description": "Bordar - Online Accelerator Platform (PHP/MySQL Edition)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "morilog/jalali": "^3.5",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": [
            "php tests/setup-test-db.php",
            "phpunit"
        ],
        "migrate": "php src/Database/migrate.php",
        "seed": "php src/Database/Seeders/run.php"
    }
}
